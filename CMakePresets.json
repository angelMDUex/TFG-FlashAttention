{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "TFG-FA default",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CUDA_ARCHITECTURES": "86"
      },
      "environment": {
        "FA_BUFFER_UNROLL": "9",
        "FA_BUFFER_NUM": "2",
        "FA_WARPS_PER_BLOCK": "2",
        "FA_MIN_CTAS_PER_SM": "3"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    }
  ]
}
